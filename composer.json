{
    "name": "phptg/transport-amphp",
    "description": "AMPHP Transport for Telegram Bot API",
    "license": "BSD-3-Clause",
    "type": "library",
    "authors": [
        {
            "name": "Sergei Predvoditelev",
            "email": "sergei@predvoditelev.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/phptg/transport-amphp/issues?state=open",
        "chat": "https://t.me/predvoditelev_chat",
        "source": "https://github.com/phptg/transport-amphp"
    },
    "funding": [
        {
            "type": "cloudtips",
            "url": "https://pay.cloudtips.ru/p/192ce69b"
        },
        {
            "type": "boosty",
            "url": "https://boosty.to/vjik"
        }
    ],
    "require": {
        "php": "8.2 - 8.6",
        "amphp/http-client": "^5.3.8",
        "phptg/bot-api": "dev-master as 0.24"
    },
    "require-dev": {
        "amphp/http-tunnel": "^2.0.1",
        "bamarni/composer-bin-plugin": "^1.9.1",
        "llm/skills": "^1.23",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-phpunit": "^2.1.2",
        "phpunit/phpunit": "^11.5.58",
        "shipmonk/dead-code-detector": "^1.4.2"
    },
    "suggest": {
        "amphp/file": "Required to upload a file passed as a path or a regular file resource."
    },
    "autoload": {
        "psr-4": {
            "Phptg\\TransportAmphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phptg\\TransportAmphp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true,
            "target-directory": "tools"
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "dependency-analyser": "composer-dependency-analyser",
        "infection": "infection --threads=max",
        "phpstan": "phpstan",
        "rector": "rector"
    }
}
