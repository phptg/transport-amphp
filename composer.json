{
    "name": "phptg/transport-amphp",
    "description": "AMPHP Transport for Telegram Bot API",
    "license": "BSD-3-Clause",
    "type": "library",
    "authors": [
        {
            "name": "Sergei Predvoditelev",
            "email": "sergei@predvoditelev.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/phptg/transport-amphp/issues?state=open",
        "chat": "https://t.me/predvoditelev_chat",
        "source": "https://github.com/phptg/transport-amphp"
    },
    "funding": [
        {
            "type": "cloudtips",
            "url": "https://pay.cloudtips.ru/p/192ce69b"
        },
        {
            "type": "boosty",
            "url": "https://boosty.to/vjik"
        }
    ],
    "require": {
        "php": "8.2 - 8.5"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8.3",
        "phpunit/phpunit": "^11.5.46"
    },
    "autoload": {
        "psr-4": {
            "Phptg\\TransportAmphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phptg\\TransportAmphp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true,
            "target-directory": "tools"
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "dependency-analyser": "composer-dependency-analyser",
        "infection": "infection --threads=max",
        "psalm": "psalm",
        "rector": "rector"
    }
}
